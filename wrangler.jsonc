{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hephzibahbehulah-github-io",
  "main": "worker-openai.js",
  "compatibility_date": "2026-09-25",
  "assets": {"directory": ".", "binding": "ASSETS"},
  "ai": {"binding": "AI"},
  "ai_search_namespaces": [{"binding":"AI_SEARCH","namespace":"default","remote":true}],
  "ratelimits": [{"name":"API_LIMITER","namespace_id":"9001","simple":{"limit":30,"period":60}}],
  "routes": [
    {"pattern":"hephzibahbehulah.com","custom_domain":true},
    {"pattern":"admin.hephzibahbehulah.com","custom_domain":true}
  ],
  "rules": {"required": ["OPENAI_API_KEY", "ADIGUN_ADMIN_EMAIL"]},
  "triggers": {"crons": ["0 */6 * * *"]}
  /* Optional production bindings once resources are created:
     "d1_databases": [{"binding":"DB","database_name":"adigun-memory","database_id":"<D1_DATABASE_ID>"}],
     "r2_buckets": [{"binding":"R2","bucket_name":"adigun-reports"}]
  */
}