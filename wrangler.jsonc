{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hephzibahbehulah-github-io",
  "main": "worker-openai.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "9001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "hephzibahbehulah.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.hephzibahbehulah.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "ADIGUN_ADMIN_EMAIL"
    ]
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "docker.io/cloudflare/sandbox:0.12.10-python",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "Sandbox",
        "name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": [
        "Sandbox"
      ],
      "tag": "adigun-sandbox-v1"
    }
  ],
  "vars": {
    "SANDBOX_LOG_LEVEL": "info",
    "SANDBOX_LOG_FORMAT": "json"
  }
}
