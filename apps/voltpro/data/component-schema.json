{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://voltpro.example/schema/component.json",
 "title":"VoltPRo Component",
 "type":"object",
 "required":["id","name","category","pins","simulation"],
 "properties":{
  "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]*$"},
  "name":{"type":"string","minLength":1},
  "category":{"type":"string"},
  "iec60617":{"type":["string","null"]},
  "ansi315":{"type":["string","null"]},
  "image":{"type":["string","null"]},
  "pins":{"type":"array","minItems":1,"items":{"type":"string"}},
  "parameters":{"type":"object"},
  "simulation":{"type":"object"},
  "datasheet":{"type":["string","null"]},
  "description":{"type":["string","null"]},
  "tags":{"type":"array","items":{"type":"string"}}
 }
}