# Native DWG conversion needs a Linux API host; GitHub Pages/Cloudflare Workers cannot run this binary.
# Build the API and GNU LibreDWG (experimental DWG writer) in a reproducible container.
FROM debian:bookworm-slim AS libredwg-build
ARG LIBREDWG_VERSION=0.14
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git autoconf automake libtool pkg-config gettext autopoint flex bison texinfo gcc g++ make \
    libxml2-dev libpcre2-dev zlib1g-dev python3 perl && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /build
RUN git clone --depth 1 --branch "${LIBREDWG_VERSION}" https://github.com/LibreDWG/libredwg.git
WORKDIR /build/libredwg
RUN ./autogen.sh && ./configure --enable-release && make -j2 && make install && ldconfig && \
    test -x /usr/local/bin/dxf2dwg

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production PORT=4000 HOST=0.0.0.0 VOLTPRO_DB_PATH=/data/voltpro.sqlite LIBREDWG_DXF2DWG=/usr/local/bin/dxf2dwg
RUN apt-get update && apt-get install -y --no-install-recommends libxml2 libpcre2-8-0 zlib1g ca-certificates && \
    rm -rf /var/lib/apt/lists/* && mkdir -p /app /data && chown -R node:node /app /data
COPY --from=libredwg-build /usr/local/ /usr/local/
RUN ldconfig
WORKDIR /app
COPY --chown=node:node server/ ./server/
USER node
EXPOSE 4000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node","server/server.mjs"]
